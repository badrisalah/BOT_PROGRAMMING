#include <bits/stdc++.h>
using namespace std;

struct Tree {
    int x, y;
    int fruits;
    string type;
    long long dist_sq;
    int index;

    bool operator<(const Tree& other) const {
        return dist_sq < other.dist_sq;
    }
};

int main()
{
    int width, height;
    cin >> width >> height;
    cin.ignore();
    vector<string> grid(height);
    int shkx = 0, shky = 0;

    // find shack
    vector<pair<int,int>> iron;
    for (int i = 0; i < height; i++) {
        string line;
        getline(cin, line);
        grid[i] = line;
        for (int j = 0; j < line.size(); j++) {
            if (line[j] == '0') {
                shkx = j;
                shky = i;
            }
            else if (line[j] == '+')
                iron.push_back({j,i});
        }
    }

    // planting spots around shack — BOUNDS CHECKED
vector<pair<int,int>> plant_spots;
vector<vector<int>> vis(height, vector<int>(width, 0));

queue<pair<int,int>> q;

q.push({shkx, shky});
vis[shky][shkx] = 1;

int dx4[4] = {1, -1, 0, 0};
int dy4[4] = {0, 0, 1, -1};

while (!q.empty() && plant_spots.size() < 6)
{
    auto cur = q.front();
    q.pop();

    int x = cur.first;
    int y = cur.second;

    for (int d = 0; d < 4; d++)
    {
        int nx = x + dx4[d];
        int ny = y + dy4[d];

        if (nx < 0 || nx >= width || ny < 0 || ny >= height)
            continue;

        if (vis[ny][nx])
            continue;

        vis[ny][nx] = 1;

        char c = grid[ny][nx];

        if (c == '.')
        {
            plant_spots.push_back({nx, ny});
            q.push({nx, ny});
        }
    }
}
    set<pair<int,int>> planted_spots;


    int planted = 0;
    string saved_tree_type = "PLUM";
    bool chopping_mode = false;
    int chop_x = -1;
    int chop_y = -1;

    while (1)
    {
        // inventories
        int my_plums, my_lemons, my_apples, my_bananas, res1, res2;
        cin >> my_plums >> my_lemons >> my_apples >> my_bananas >> res1 >> res2;
        cin.ignore();

        int opp_plums, opp_lemons, opp_apples, opp_bananas, res3, res4;
        cin >> opp_plums >> opp_lemons >> opp_apples >> opp_bananas >> res3 >> res4;
        cin.ignore();

        // trees
        int trees_count;
        cin >> trees_count;
        cin.ignore();

        vector<Tree> bananatrees;
        vector<Tree> lemontrees;
        vector<Tree> plumtrees;
        vector<Tree> appletrees;
        set<pair<int,int>> tree_positions;

        for (int i = 0; i < trees_count; i++) {
            string type;
            int x, y, size, health, fruits, cooldown;

            cin >> type >> x >> y >> size >> health >> fruits >> cooldown;
            cin.ignore();

            if (type == "BANANA" && fruits > 0)
                bananatrees.push_back({x,y,fruits,type,0,i});
            else if (type == "PLUM"&& fruits > 0)
                plumtrees.push_back({x,y,fruits,type,0,i});
            else if (type == "APPLE"&& fruits > 0)
                appletrees.push_back({x,y,fruits,type,0,i});
            else if (type == "LEMON"&& fruits > 0)
                lemontrees.push_back({x,y,fruits,type,0,i});
        }

        int trolls_count;
        cin >> trolls_count;
        cin.ignore();

        vector<pair<int, pair<int, int>>> my_trolls;
        map<int, int> troll_carry;

        for (int i = 0; i < trolls_count; i++) {

            int id, player, x, y;
            int movement_speed, carry_capacity, harvest_power, chop_power;
            int carry_plum, carry_lemon, carry_apple, carry_banana;
            int res5, res6;

            cin >> id >> player >> x >> y
                >> movement_speed >> carry_capacity
                >> harvest_power >> chop_power
                >> carry_plum >> carry_lemon
                >> carry_apple >> carry_banana
                >> res5 >> res6;

            cin.ignore();
           
            if (player == 0) {

                int carry =
                    carry_plum +
                    carry_lemon +
                    carry_apple +
                    carry_banana + res5 + res6;

                my_trolls.push_back({id, {x, y}});
                troll_carry[id] = carry;
            }
        }

        sort(my_trolls.begin(), my_trolls.end());

        vector<string> commands;
        //
        //  FIRST TROLL : HOW MUCH DOES HE NEED TO MAKE A TROLL WITH : 3 2 2 2
        //
                //
        for(int i = 0; i < my_trolls.size(); i++)
        {
            int troll_id = my_trolls[i].first;
            int troll_x = my_trolls[i].second.first;
            int troll_y = my_trolls[i].second.second;
            int carry = troll_carry[troll_id];
        
            string command = "";
        
            //  TROLL[0] TRAINING LOGIC
            if (i == 0 && my_trolls.size() == 1)  // First troll only
            {
                int num_trolls = my_trolls.size();

                int cost_movement = num_trolls + (3 * 3);  
                int cost_carry = num_trolls + (3 * 3);     
                int cost_harvest = num_trolls + (1 * 1);   
                int cost_chop = num_trolls + (2 * 2);      
            
                if (my_plums >= cost_movement &&
                    my_lemons >= cost_carry &&
                    my_apples >= cost_harvest &&
                    res1 >= cost_chop)
                {
                    command = "TRAIN 3 3 1 2";
                }
                else
                {
                    // =========================
                    // 1) IF CARRYING → RETURN SHACK
                    // =========================
                    if (carry > 0)
                    {
                        // cerr<<carry<<endl;
                        int dist_to_shack = abs(troll_x - shkx) + abs(troll_y - shky);
                        
                        if (dist_to_shack == 1)
                        {
                            command = "DROP " + to_string(troll_id);
                        }
                        else
                        {
                            command = "MOVE " + to_string(troll_id) + " " +
                                      to_string(shkx) + " " +
                                      to_string(shky);
                        }
                    }
                    else
                    {
                        if (carry > 0)
                        {
                            // Return to shack to drop
                            int dist_to_shack = abs(troll_x - shkx) + abs(troll_y - shky);

                            if (dist_to_shack == 1)
                                command = "DROP " + to_string(troll_id);
                            else
                                command = "MOVE " + to_string(troll_id) + " " +
                                          to_string(shkx) + " " + to_string(shky);
                        }
                        else
                        {
                            // Determine which resource we need most
                            vector<Tree>* target = nullptr;

                            if (my_lemons < cost_carry && !lemontrees.empty())
                                target = &lemontrees;
                            else if (my_plums < cost_movement && !plumtrees.empty())
                                target = &plumtrees;
                            else if (my_apples < cost_harvest && !appletrees.empty())
                                target = &appletrees;
                            else if (my_bananas < cost_chop && !bananatrees.empty())
                                target = &bananatrees;

                            if (target && !target->empty())
                            {
                                // Find closest tree with Manhattan distance
                                Tree best = (*target)[0];
                                long long min_dist = LLONG_MAX;
                            
                                for (auto &t : *target)
                                {
                                    long long dist = abs(t.x - troll_x) + abs(t.y - troll_y);
                                
                                    if (dist < min_dist)
                                    {
                                        min_dist = dist;
                                        best = t;
                                    }
                                }
                            
                                if (troll_x == best.x && troll_y == best.y)
                                    command = "HARVEST " + to_string(troll_id);
                                else
                                    command = "MOVE " + to_string(troll_id) + " " +
                                              to_string(best.x) + " " + to_string(best.y);
                            }
                            else
                            {
                                if (!iron.empty())
                                {
                                    // Find closest iron ore
                                    pair<int,int> best_iron = iron[0];
                                    long long min_dist = LLONG_MAX;

                                    for (auto &p : iron)
                                    {
                                        long long dist = abs(p.first - troll_x) + abs(p.second - troll_y);
                                        if (dist < min_dist)
                                        {
                                            min_dist = dist;
                                            best_iron = p;
                                        }
                                    }
                                    int dist_to_iron = abs(troll_x - best_iron.first) + abs(troll_y - best_iron.second);
                                    if (dist_to_iron == 1)
                                        command = "MINE " + to_string(troll_id);
                                    else
                                        command = "MOVE " + to_string(troll_id) + " " +
                                                  to_string(best_iron.first) + " " + to_string(best_iron.second);
                                }
                                else
                                {
                                    command = "WAIT";  // No iron available
                                }
                            }
                        }
                    }
                    
                }
            }
            else { //TROLLS SIZE == 2 
                cerr<<"heeer\n"<<endl;
                if (i == 0) // planter troll
                {
                    
                    if (planted >= plant_spots.size())
                    {
                        command = "WAIT";
                    }
                    else
                    {
                        int px = plant_spots[planted].first;
                        int py = plant_spots[planted].second;
                    
                        // =====================================
                        // HAS SEED -> GO PLANT
                        // =====================================
                        if (carry > 0)
                        {
                            if (troll_x == px && troll_y == py)
                            {
                                command =
                                    "PLANT " +
                                    to_string(troll_id) + " " +
                                    saved_tree_type;
                                chopping_mode = true;
                                chop_x = px;
                                chop_y = py;
                                planted++;
                            }
                            else
                            {
                                command =
                                    "MOVE " +
                                    to_string(troll_id) + " " +
                                    to_string(px) + " " +
                                    to_string(py);
                            }
                        }
                    
                        // =====================================
                        // NO SEED -> GO PICK
                        // =====================================
                        else
                        {
                            int dist_to_shack = abs(troll_x - shkx) + abs(troll_y - shky);
                            if (dist_to_shack == 1)
                            {
                                if (my_plums > 0)
                                {
                                    saved_tree_type = "PLUM";
                                
                                    command =
                                        "PICK " +
                                        to_string(troll_id) +
                                        " PLUM";
                                }
                                else if (my_lemons > 0)
                                {
                                    saved_tree_type = "LEMON";
                                
                                    command =
                                        "PICK " +
                                        to_string(troll_id) +
                                        " LEMON";
                                }
                                else if (my_apples > 0)
                                {
                                    saved_tree_type = "APPLE";
                                
                                    command =
                                        "PICK " +
                                        to_string(troll_id) +
                                        " APPLE";
                                }
                                else if (my_bananas > 0)
                                {
                                    saved_tree_type = "BANANA";
                                
                                    command =
                                        "PICK " +
                                        to_string(troll_id) +
                                        " BANANA";
                                }
                                else
                                {
                                    command = "WAIT";
                                }
                            }
                        
                            // move to shack
                            else
                            {
                                command =
                                    "MOVE " +
                                    to_string(troll_id) + " " +
                                    to_string(shkx) + " " +
                                    to_string(shky);
                            }
                        }
                    }
                }
                else {
                    //
                }
            }
        
            commands.push_back(command);
        }
        for (int i = 0; i < commands.size(); i++) {
            cout << commands[i];

            if (i + 1 < commands.size())
                cout << ";";
        }

        cout << endl;
    }

    return 0;
}
